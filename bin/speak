#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["edge-tts>=7", "num2words>=0.5.13"]
# ///
"""Read text aloud: Russian, English, or a mix of both.

  speak "текст"            text as arguments
  pbpaste | speak          text from stdin (markdown and tables are cleaned)
  speak --local "текст"    fully offline (Silero), nothing leaves the machine
  speak -r +15% "текст"    faster speech (cloud mode)
  speak -o out.mp3 "..."   save to a file instead of playing (.wav with --local)

Cloud mode sends the text to Microsoft's Edge Read Aloud service.
Use --local for anything confidential.

Pronunciation fixes: "4-й" is read as "четвёртый", "в 3-х" as "в трёх", and
your own replacements come from ~/.config/claude-say/pronounce.txt.
"""

import argparse
import asyncio
import os
import re
import subprocess
import sys
import tempfile
import threading
import queue

# "auto": text with any Russian word -> Dmitry, the rest -> Andrew. The multilingual Andrew
# reads Russian with an accent once an English word is in the sentence.
DEFAULT_VOICE = "auto"
VOICE_RU = "ru-RU-DmitryNeural"
VOICE_EN = "en-US-AndrewMultilingualNeural"
LOCAL_HELPER = os.path.join(os.path.dirname(os.path.realpath(__file__)), "speak-local.py")
DICTIONARY = os.path.expanduser("~/.config/claude-say/pronounce.txt")
DICTIONARY_HEADER = """\
# How speak (and !say) should pronounce words. One rule per line:
#
#   word = how to say it        whole word, any letter case
#   re: regex = replacement     a Python regex, \\1 refers to a group
#
# Lines starting with # are comments. Rules run top to bottom, before the voice.
# Check a rule without listening: speak --print "text"
#
# k8s = кубернетис
# re: (\\d+)\\s*мс = \\1 миллисекунд
"""


# ---------- text cleaning ----------

def _table_to_speech(lines):
    rows = []
    for ln in lines:
        cells = [c.strip() for c in ln.strip().strip("|").split("|")]
        if all(re.fullmatch(r":?-{2,}:?", c) or c == "" for c in cells):
            continue
        rows.append(cells)
    if not rows:
        return ""
    header, body = rows[0], rows[1:]
    if not body:
        return ". ".join(c for c in header if c) + "."
    out = []
    for r in body:
        parts = []
        for i, c in enumerate(r):
            if not c:
                continue
            h = header[i] if i < len(header) else ""
            parts.append(f"{h}: {c}" if h else c)
        out.append(", ".join(parts) + ".")
    return "\n".join(out)


def clean(text: str) -> str:
    text = re.sub(r"```.*?```", "\n(блок кода пропущен)\n", text, flags=re.S)
    text = re.sub(r"<[^>\n]+>", " ", text)  # html-ish tags

    lines, out, table = text.splitlines(), [], []
    for ln in lines + [""]:
        if re.match(r"^\s*\|.*\|\s*$", ln):
            table.append(ln)
            continue
        if table:
            out.append(_table_to_speech(table))
            table = []
        out.append(ln)
    text = "\n".join(out)

    text = re.sub(r"!\[([^\]]*)\]\([^)]*\)", r"\1", text)      # images
    text = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", text)        # links
    text = re.sub(r"https?://\S+", "ссылка", text)
    text = re.sub(r"`([^`]*)`", r"\1", text)                    # inline code
    # long paths -> last component
    text = re.sub(r"(?:~|\.|[\w.\-]+)?(?:/[\w.\-]+){2,}/?", lambda m: m.group(0).rstrip("/").rsplit("/", 1)[-1], text)
    text = re.sub(r"^\s{0,3}#{1,6}\s*", "", text, flags=re.M)   # headers
    text = re.sub(r"^\s*>\s?", "", text, flags=re.M)            # quotes
    text = re.sub(r"^\s*(?:[-*+]|\d+[.)])\s+", "", text, flags=re.M)  # bullets
    text = re.sub(r"^\s*([-*_]\s*){3,}$", "", text, flags=re.M)  # hr
    text = re.sub(r"(\*\*|__|\*|~~)(.+?)\1", r"\2", text)
    text = text.replace("→", " в ").replace("=>", " в ").replace("->", " в ")
    text = re.sub(r"[ \t]+", " ", text)
    # a line without final punctuation gets a period, so the voice pauses
    text = "\n".join(
        (l.strip() + ("" if re.search(r"[.!?:;,…]$", l.strip()) else "."))
        for l in text.splitlines() if l.strip()
    )
    return text.strip()


# ---------- pronunciation ----------

# Suffix after "4-": (ordinal or cardinal, num2words options).
# "-х", "-ти", "-ми" are cardinal in everyday writing: "из 3-х" = "из трёх".
SUFFIXES = {
    "й": ("o", {}), "ый": ("o", {}), "ий": ("o", {}),
    "я": ("o", {"gender": "f"}), "ая": ("o", {"gender": "f"}), "ья": ("o", {"gender": "f"}),
    "е": ("o", {"gender": "n"}), "ое": ("o", {"gender": "n"}), "ье": ("o", {"gender": "n"}),
    "го": ("o", {"case": "genitive"}), "ого": ("o", {"case": "genitive"}),
    "му": ("o", {"case": "dative"}), "ому": ("o", {"case": "dative"}),
    "ом": ("o", {"case": "prepositional"}),
    "ым": ("o", {"case": "instrumental"}),
    "ой": ("o", {"gender": "f", "case": "genitive"}),
    "ю": ("o", {"gender": "f", "case": "accusative"}), "ую": ("o", {"gender": "f", "case": "accusative"}),
    "ые": ("o", {"plural": True}), "ых": ("o", {"plural": True, "case": "genitive"}),
    "ыми": ("o", {"plural": True, "case": "instrumental"}),
    "х": ("c", {"case": "genitive"}), "ти": ("c", {"case": "genitive"}),
    "ми": ("c", {"case": "instrumental"}),
}
PREP_WORDS = {"в", "во", "на", "о", "об", "при"}


def _number_with_suffix(m):
    from num2words import num2words

    before, num, suf = m.group(1), int(m.group(2)), m.group(3).lower()
    if suf == "м":  # "в 4-м" -> четвёртом, "с 4-м" -> четвёртым
        prev = re.findall(r"[а-яё]+", before.lower())
        kind, kw = "o", {"case": "prepositional" if prev and prev[-1] in PREP_WORDS else "instrumental"}
    else:
        kind, kw = SUFFIXES[suf]
    try:
        word = num2words(num, lang="ru", to="ordinal" if kind == "o" else "cardinal", **kw)
    except Exception:
        return m.group(0)
    return before + word


def load_dictionary():
    if not os.path.exists(DICTIONARY):
        try:
            os.makedirs(os.path.dirname(DICTIONARY), exist_ok=True)
            with open(DICTIONARY, "w", encoding="utf-8") as fh:
                fh.write(DICTIONARY_HEADER)
        except OSError:
            pass
        return []
    rules = []
    with open(DICTIONARY, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            src, dst = (x.strip() for x in line.rsplit("=", 1))
            try:
                if src.startswith("re:"):
                    rules.append((re.compile(src[3:].strip()), dst))
                else:
                    rules.append((re.compile(rf"(?<!\w){re.escape(src)}(?!\w)", re.I), dst.replace("\\", "\\\\")))
            except re.error as e:
                print(f"speak: bad rule in {DICTIONARY}: {line} ({e})", file=sys.stderr)
    return rules


def pronounce(text: str) -> str:
    """Rewrite what voices get wrong. Runs on every text, cleaned or --raw."""
    for rx, dst in load_dictionary():
        text = rx.sub(dst, text)
    suf = "|".join(sorted(list(SUFFIXES) + ["м"], key=len, reverse=True))
    text = re.sub(rf"((?:^|\W)(?:[а-яёА-ЯЁ]+\s+)?)(\d+)\s*-\s*({suf})(?![а-яё])", _number_with_suffix, text)
    return text


def chunks(text: str, limit: int = 600):
    """Split on paragraphs, then sentences, so playback starts fast."""
    buf = ""
    for para in text.split("\n"):
        for sent in re.split(r"(?<=[.!?…])\s+", para):
            if buf and len(buf) + len(sent) > limit:
                yield buf
                buf = ""
            buf = f"{buf} {sent}".strip()
        if len(buf) > limit // 3:
            yield buf
            buf = ""
    if buf:
        yield buf


# ---------- cloud (edge-tts) ----------

def _player(q: "queue.Queue[str | None]"):
    while (path := q.get()) is not None:
        subprocess.run(["afplay", path])
        os.unlink(path)


def pick_voice(voice, text):
    if voice != "auto":
        return voice
    # Any Russian word -> Dmitry. Andrew switches the whole sentence to English
    # as soon as the English part is long ("NASA-328 даёт ему кнопку Start refund").
    # Text with no English word ("1.", "16") is Russian too: Andrew says "one".
    if re.search(r"[а-яёА-ЯЁ]{2,}", text) or not re.search(r"[a-zA-Z]{2,}", text):
        return VOICE_RU
    return VOICE_EN


async def speak_cloud(text, voice, rate, outfile):
    import edge_tts

    if outfile:
        await edge_tts.Communicate(text, pick_voice(voice, text), rate=rate).save(outfile)
        return
    q: "queue.Queue[str | None]" = queue.Queue()
    t = threading.Thread(target=_player, args=(q,), daemon=True)
    t.start()
    try:
        for part in chunks(text):
            fd, path = tempfile.mkstemp(suffix=".mp3", prefix="speak-")
            os.close(fd)
            await edge_tts.Communicate(part, pick_voice(voice, part), rate=rate).save(path)
            q.put(path)
    finally:
        q.put(None)
        t.join()


def speak_local(text, outfile=None):
    env = dict(os.environ, SPEAK_OUT=outfile) if outfile else None
    subprocess.run(["uv", "run", "--quiet", "--script", LOCAL_HELPER], input=text.encode(), check=True, env=env)


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("text", nargs="*")
    p.add_argument("--local", action="store_true", help="offline Silero voice, nothing is sent anywhere")
    p.add_argument("-v", "--voice", default=os.environ.get("SPEAK_VOICE", DEFAULT_VOICE),
                   help="auto (Dmitry for Russian, Andrew for English) or an edge-tts voice id")
    p.add_argument("-r", "--rate", default=os.environ.get("SPEAK_RATE", "+0%"), help="e.g. +15%%, -10%%")
    p.add_argument("-o", "--out", help="save audio instead of playing (mp3, or wav with --local)")
    p.add_argument("--raw", action="store_true", help="skip markdown cleaning")
    p.add_argument("--print", action="store_true", help="only print the cleaned text")
    a = p.parse_args()

    text = " ".join(a.text) if a.text else sys.stdin.read()
    if not a.raw:
        text = clean(text)
    text = pronounce(text)
    if not text:
        return
    if a.print:
        print(text)
        return
    try:
        if a.local or os.environ.get("SPEAK_LOCAL") == "1":
            speak_local(text, a.out)
        else:
            try:
                asyncio.run(speak_cloud(text, a.voice, a.rate, a.out))
            except Exception as e:  # offline or service broken
                if a.out:  # the caller handles its own fallback
                    sys.exit(f"speak: cloud failed ({e.__class__.__name__})")
                print(f"speak: cloud failed ({e.__class__.__name__}), using local voice", file=sys.stderr)
                speak_local(text)
    except KeyboardInterrupt:
        subprocess.run(["pkill", "-x", "afplay"])


if __name__ == "__main__":
    main()
